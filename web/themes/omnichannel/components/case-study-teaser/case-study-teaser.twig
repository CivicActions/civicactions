{#
/**
 * @file
 * Template for the CivicActions Case Study Teaser component.
 *
 * Available props:
 * - heading_level: Heading level for the case study title.
 * - teaserlink: Case study destination.
 * - image: Optional Media Library image.
 * - client: Client or partner name.
 * - title: Case study heading.
 * - summary: Optional case study summary.
 */
#}
{% set teaser_attributes = attributes|default(create_attribute()) %}
{% set teaser_heading_tags = {2: 'h2', 3: 'h3', 4: 'h4', 5: 'h5', 6: 'h6'} %}
{% set teaser_heading_tag = teaser_heading_tags[heading_level|default(2)]|default('h2') %}

<article {{ teaser_attributes.addClass('ca-case-study-teaser') }}>
  <a href="{{ teaserlink|e('html_attr') }}" class="ca-case-study-teaser__link">
    {% if image %}
      {% set image_srcset = image.src|toSrcSet(image.width) %}
      <img
        class="ca-case-study-teaser__image"
        src="{{ file_url(image.src)|e('html_attr') }}"
        {% if image_srcset %}
          srcset="{{ image_srcset|e('html_attr') }}"
          sizes="auto, 100vw"
        {% endif %}
        alt="{{ image.alt|default('')|e('html_attr') }}"
        width="{{ image.width|e('html_attr') }}"
        height="{{ image.height|e('html_attr') }}"
        loading="lazy"
      >
    {% endif %}
    <div class="ca-case-study-teaser__content">
      {% if client %}
        <span class="ca-case-study-teaser__client">{{ client }}</span>
      {% endif %}
      <{{ teaser_heading_tag }} class="ca-case-study-teaser__title">{{ title }}</{{ teaser_heading_tag }}>
      {% if summary %}
        <p class="ca-case-study-teaser__summary">{{ summary }}</p>
      {% endif %}
    </div>
  </a>
</article>