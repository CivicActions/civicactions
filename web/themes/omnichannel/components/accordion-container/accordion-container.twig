{#
/**
 * @file
 * Container for single-item Accordion components.
 *
 * Available slots:
 * - accordion_content: Accordion items displayed inside the container.
 */
#}
{% set accordion_container_attributes = attributes|default(create_attribute()) %}
{% set accordion_container_classes = ['ca-accordion-container'] %}
{% set accordion_heading_level = heading_level in [2, 3, 4, 5, 6] ? heading_level : 2 %}
{% if single_open %}
  {% set accordion_container_classes = accordion_container_classes|merge(['ca-accordion-container--single-open']) %}
{% endif %}

<div{{ accordion_container_attributes.addClass(accordion_container_classes) }}>
  {% if title %}
    <h{{ accordion_heading_level }} class="ca-accordion-container__title">{{ title }}</h{{ accordion_heading_level }}>
  {% endif %}
  {% block accordion_content %}{% endblock %}
</div>
