{#
/**
 * @file
 * Template for the CivicActions Site Footer component.
 *
 * Available props:
 * - heading_id: ID of the visually hidden heading labelling the navigation.
 *
 * Available slots:
 * - branding: Footer logo.
 * - about: Short description of the organization.
 * - contact: Mailing address, phone, and email.
 * - menu: Primary footer navigation links.
 * - social: Social media icon links.
 * - bottom_links: Legal and policy links.
 */
#}
{% set heading_id = heading_id|default('footer--menu') %}
{% set footer_attributes = attributes|default(create_attribute()) %}

<footer{{ footer_attributes.addClass('footer').setAttribute('id', 'footer--section') }}>
  <div class="footer__inner">
    <div class="footer__area footer__branding">
      {% block branding %}
        {% if page.footer.omnichannel_sitebranding_2 is not empty %}
          {{ page.footer.omnichannel_sitebranding_2 }}
        {% else %}
          <a class="site-logo" href="{{ path('<front>') }}" aria-label="{{ 'CivicActions home page'|t }}">
            {{ source(componentMetadata.path ~ '/ca-extended-logo.svg') }}
          </a>
        {% endif %}
      {% endblock %}
    </div>

    <div class="footer__area footer__about">
      {% block about %}
        {% include '@omnichannel/templates/partials/footer/about.html.twig' only %}
      {% endblock %}
    </div>

    <div class="footer__area footer__contact">
      {% block contact %}
        {% include '@omnichannel/templates/partials/footer/contact.html.twig' only %}
      {% endblock %}
    </div>

    <div class="footer__area footer__menu--wrapper">
      {% block menu %}
        {% if page.footer.omnichannel_footer is not empty %}
          {{ page.footer.omnichannel_footer }}
        {% endif %}      
      {% endblock %}
      </nav>
    </div>

    <div class="footer__area footer__social">
      {% block social %}
        {% include 'omnichannel:social-links' with {
        vimeo_url: 'https://vimeo.com/civicactions',
        bluesky_url: 'https://bsky.app/profile/civicactions.com',
        x_url: 'https://twitter.com/civicactions?lang=en',
        linkedin_url: 'https://www.linkedin.com/company/civicactions/mycompany/',
        } only %}
      {% endblock %}
    </div>

    <div class="footer__area footer__bottom--links">
      {{ page.footer_bottom }}
    </div>
  </div>
</footer>
