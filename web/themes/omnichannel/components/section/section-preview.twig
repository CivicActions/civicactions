{% extends './section.twig' %}

{% block column_one %}
  <div style="box-sizing: border-box; display: flex; min-height: 8rem; align-items: center; justify-content: center; padding: var(--size-4); border: 2px dashed var(--gray-30); border-radius: 4px; background-color: var(--gray-10); color: var(--gray-70); text-align: center;">
    Column one
  </div>
{% endblock %}

