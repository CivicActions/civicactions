{#
/**
 * @file
 * Template for the CivicActions Editorial Teaser component.
 *
 * Available props:
 * - variant: Content type ('press' or 'news').
 * - layout: Press release layout ('card' or 'compact').
 * - teaserlink: Press release destination.
 * - date: News date (news only).
 * - fullstorylink: Full story destination (news only).
 * - image: Optional Media Library image.
 * - title: Teaser heading.
 * - description: Optional teaser description.
 */
#}

{% set teaser_variant = variant|default('press') %}
{% set teaser_classes = [
  'editorial-teaser--' ~ teaser_variant,
] %}
{% set teaser_attributes = attributes|default(create_attribute()) %}

<div {{ teaser_attributes.addClass(teaser_classes) }}>
  {% if teaser_variant == 'press' %}
    {% set press_args = {
      layout: layout|default('card'),
      teaserlink: teaserlink,
      title: title,
    } %}
    {% if image %}
      {% set press_args = press_args|merge({ image: image }) %}
    {% endif %}
    {% if description %}
      {% set press_args = press_args|merge({ description: description }) %}
    {% endif %}
    {% include 'omnichannel:editorial-press-teaser' with press_args only %}
  {% elseif teaser_variant == 'news' %}
    {% set news_args = {
      title: title,
      fullstorylink: fullstorylink|default(teaserlink),
    } %}
    {% if date %}
      {% set news_args = news_args|merge({ date: date }) %}
    {% endif %}
    {% if description %}
      {% set news_args = news_args|merge({ description: description }) %}
    {% endif %}
    {% include 'omnichannel:editorial-news-teaser' with news_args only %}
  {% endif %}
</div>
