{#
/**
 * @file
 * Template for the CivicActions Accordion component.
 *
 * Available props:
 * - title: Optional heading for the accordion group.
 * - item_id: Optional unique ID seed for this disclosure item.
 * - heading_level: Heading level for the disclosure trigger (2 through 6).
 * - open_by_default: Whether the item starts expanded.
 *
 * Available slots:
 * - accordion_content: Content shown when this item is expanded.
 */
#}
{% set accordion_attributes = attributes|default(create_attribute()) %}
{% set h_level = heading_level in [2, 3, 4, 5, 6] ? heading_level : 3 %}
{% set accordion_id = item_id|default(title|default('item'))|clean_id %}
{% set accordion_title_id = 'accordion-title-' ~ accordion_id %}
{% set accordion_content_id = 'accordion-content-' ~ accordion_id %}

<details{{ accordion_attributes.addClass('ca-accordion') }}{% if open_by_default %} open{% endif %}>
  <summary class="ca-accordion__summary" aria-controls="{{ accordion_content_id|e('html_attr') }}">
    <span class="ca-accordion__title" role="heading" aria-level="{{ h_level }}" id="{{ accordion_title_id|e('html_attr') }}">{{ title }}</span>
    <span class="ca-accordion__icon" aria-hidden="true">
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M4 6L8 10L12 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      </svg>
    </span>
  </summary>
  <div class="ca-accordion__content" id="{{ accordion_content_id|e('html_attr') }}" role="region" aria-labelledby="{{ accordion_title_id|e('html_attr') }}">
    {% block accordion_content %}{% endblock %}
  </div>
</details>
