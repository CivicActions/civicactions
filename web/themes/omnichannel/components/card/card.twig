{#
/**
 * @file
 * Template for the CivicActions Card component.
 *
 * Available props:
 * - heading_level: Heading level for the card title.
 * - title: Card heading.
 * - link: Card destination.
 * - icon: Icon image URL.
 * - icon_alt: Icon alternative text. Leave empty for decorative icons.
 * - icon_name: Optional icon symbol name from the Icon SDC.
 * - body: Optional supporting text.
 */
#}
{% set card_attributes = attributes|default(create_attribute()) %}
{% set card_classes = ['ca-card'] %}
{% set card_heading_tags = {2: 'h2', 3: 'h3', 4: 'h4', 5: 'h5', 6: 'h6'} %}
{% set card_heading_tag = card_heading_tags[heading_level|default(3)]|default('h3') %}
{% set card_tag = link ? 'a' : 'div' %}

<{{ card_tag }}{% if link %} href="{{ link|e('html_attr') }}"{% endif %} {{ card_attributes.addClass(card_classes) }}>
  {% if icon_name and icon_name != 'none' %}
    <span class="ca-card__icon ca-card__icon--symbol">
      {% include 'omnichannel:icon' with { name: icon_name, size: 'xl', color: 'primary-blue' } only %}
    </span>
  {% elseif (icon_name is not defined or icon_name == '') and icon %}
    <img class="ca-card__icon" src="{{ icon|e('html_attr') }}" alt="{{ icon_alt|default('')|e('html_attr') }}">
  {% endif %}
  <div class="ca-card__content">
    {% if title %}
      <{{ card_heading_tag }} class="ca-card__title">{{ title }}</{{ card_heading_tag }}>
    {% endif %}
    {% if body %}
      <p class="ca-card__body">{{ body }}</p>
    {% endif %}
  </div>
</{{ card_tag }}>
