{#
/**
 * @file
 * Template for the CivicActions Icon component.
 *
 * Available props:
 * - name: Name of the icon (check, calendar, certificate, users, arrow, document, star).
 * - size: Size token (sm, md, lg, xl).
 * - color: Color token (inherit, primary-red, primary-blue, light-blue, gray-90).
 * - aria_label: Optional accessible label.
 */
#}
{% set icon_attributes = attributes|default(create_attribute()) %}
{% set icon_name = name|default('check') %}
{% set icon_size = size|default('md') %}
{% set icon_color = color|default('inherit') %}

{% set icon_classes = [
  'ca-icon',
  'ca-icon--' ~ icon_name,
  'ca-icon--size-' ~ icon_size,
  'ca-icon--color-' ~ icon_color,
] %}

<span{{ icon_attributes.addClass(icon_classes) }}>
  <svg
    class="ca-icon__svg"
    viewBox="0 0 24 24"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    {% if aria_label is not empty %}
      role="img"
      aria-label="{{ aria_label|e('html_attr') }}"
    {% else %}
      aria-hidden="true"
      focusable="false"
    {% endif %}
  >
    {% if icon_name == 'check' %}
      <path d="M5 13l4 4L19 7" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
    {% elseif icon_name == 'calendar' %}
      <rect x="3" y="4" width="18" height="18" rx="2" ry="2" stroke="currentColor" stroke-width="2"/>
      <line x1="16" y1="2" x2="16" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="8" y1="2" x2="8" y2="6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="3" y1="10" x2="21" y2="10" stroke="currentColor" stroke-width="2"/>
    {% elseif icon_name == 'certificate' %}
      <circle cx="12" cy="9" r="6" stroke="currentColor" stroke-width="2"/>
      <path d="M8.21 13.89L7 22l5-3 5 3-1.21-8.11" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {% elseif icon_name == 'users' %}
      <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <circle cx="9" cy="7" r="4" stroke="currentColor" stroke-width="2"/>
      <path d="M23 21v-2a4 4 0 0 0-3-3.87" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <path d="M16 3.13a4 4 0 0 1 0 7.75" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {% elseif icon_name == 'arrow' %}
      <path d="M5 12h14M12 5l7 7-7 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {% elseif icon_name == 'document' %}
      <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <polyline points="14 2 14 8 20 8" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
      <line x1="16" y1="13" x2="8" y2="13" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
      <line x1="16" y1="17" x2="8" y2="17" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
    {% elseif icon_name == 'star' %}
      <polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
    {% endif %}
  </svg>
</span>
