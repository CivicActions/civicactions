{#
/**
 * @file
 * Template for the CivicActions Icon component.
 *
 * Available props:
 * - name: Name of the icon (check, calendar, certificate, users, arrow, document, star).
 * - size: Size token (sm, md, lg, xl).
 * - color: Color token (inherit, primary-red, primary-blue, light-blue, gray-90).
 * - aria_label: Optional accessible label.
 */
#}
{% set icon_attributes = attributes|default(create_attribute()) %}
{% set icon_name = name|default('check') %}
{% set icon_size = size|default('md') %}
{% set icon_color = color|default('inherit') %}

{% set icon_classes = [
  'ca-icon',
  'ca-icon--' ~ icon_name,
  'ca-icon--size-' ~ icon_size,
  'ca-icon--color-' ~ icon_color,
] %}

<span{{ icon_attributes.addClass(icon_classes) }}>
