{#
/**
 * @file
 * Theme override to display a pager.
 *
 * Available variables:
 * - heading_id: Pagination heading ID.
 * - pagination_heading_level: The heading level to use for the pager.
 * - items: Pager links, including Previous and Next when available.
 * - current: The current page number.
 * - total_pages: The total number of pages, added by OmnichannelHooks.
 *
 * @see \Drupal\Core\Pager\PagerPreprocess::preprocessPager()
 */
#}
{% if items %}
  <nav class="pager ca-pager" aria-labelledby="{{ heading_id }}">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="visually-hidden">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <div class="ca-pager__inner js-pager__items">
      <div class="ca-pager__previous">
        {% if items.previous %}
          {% set previous_attributes = items.previous.attributes
            .addClass(['ca-pager__button', 'ca-pager__button--previous'])
            .setAttribute('title', 'Go to previous page'|t)
            .setAttribute('rel', 'prev')
            .setAttribute('aria-label', 'Go to previous page'|t)
          %}
          {% include 'omnichannel:link-button' with {
            text: 'Back'|t,
            src: items.previous.href,
            attributes: previous_attributes,
          } only %}
        {% endif %}
      </div>
      <div class="ca-pager__location">
        {{ 'Page'|t }} <strong aria-current="page">{{ current }}</strong> {{ 'of'|t }} <strong>{{ total_pages }}</strong>
      </div>
      <div class="ca-pager__next">
        {% if items.next %}
          {% set next_attributes = items.next.attributes
            .addClass(['ca-pager__button', 'ca-pager__button--next'])
            .setAttribute('title', 'Go to next page'|t)
            .setAttribute('rel', 'next')
            .setAttribute('aria-label', 'Go to next page'|t)
          %}
          {% include 'omnichannel:link-button' with {
            text: 'Next'|t,
            src: items.next.href,
            attributes: next_attributes,
          } only %}
        {% endif %}
      </div>
    </div>
  </nav>
{% endif %}
