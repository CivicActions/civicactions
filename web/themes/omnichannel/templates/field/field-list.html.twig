{#
/**
 * @file
 * Shared partial: renders a field's items as a ul list.
 *
 * Included by field--field-tools.html.twig and field--field-expertise.html.twig.
 */
#}
{%
  set classes = [
    'field',
    'field--name-' ~ field_name|clean_class,
    'field--type-' ~ field_type|clean_class,
    'field--label-' ~ label_display,
  ]
%}
{% if items %}
  <div{{ attributes.addClass(classes) }}>
    {% if not label_hidden %}
      <div{{ title_attributes.addClass('field__label', label_display == 'visually_hidden' ? 'visually-hidden') }}>{{ label }}</div>
    {% endif %}
    <ul class="field__items">
      {% for item in items %}
        <li{{ item.attributes.addClass('field__item') }}>{{ item.content }}</li>
      {% endfor %}
    </ul>
  </div>
{% endif %}
