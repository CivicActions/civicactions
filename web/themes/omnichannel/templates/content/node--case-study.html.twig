{#
/**
 * @file
 * Case study detail fields in legacy page order, using case_study_props.
 */
#}
{% extends "node.html.twig" %}

{% block node_content %}
  {% if view_mode != 'full' %}
    {{ parent() }}
  {% else %}
    {{ attach_library('omnichannel/case-study') }}
    {% set props = case_study_props %}
    {% set narrow_width = true %}
    {% include 'omnichannel:case-study-header' with props %}

    <div class="ca-case-study__hero">
      {{ props.hero_image }}
    </div>

    {% if props.proofpoints_component_props is not empty %}
      <div class="ca-case-study__proofpoints">
        {% include 'omnichannel:proofpoints' with props.proofpoints_component_props|merge({ card_style: true }) only %}
      </div>
    {% endif %}

    <div{{ content_attributes.addClass('node__content ca-container ca-container--narrow') }}>
      {{ props.body }}
    </div>
  {% endif %}
{% endblock %}
