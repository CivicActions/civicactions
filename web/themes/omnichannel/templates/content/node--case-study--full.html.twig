{#
/**
 * @file
 * Case study detail fields in legacy page order, using case_study_props.
 */
#}
{% extends "node.html.twig" %}

{% block node_content %}
  {% if view_mode != 'full' %}
    {{ parent() }}
  {% else %}
    {{ attach_library('omnichannel/case-study') }}
    {% set props = case_study_props %}
    {% include 'omnichannel:case-study-header' with {
      title: props.title,
      client: props.client,
      description: props.description,
      narrow_width: true,
    } only %}

    {% if props.hero_image is not empty %}
      <div class="ca-case-study__hero ca-container">
        {{ props.hero_image }}
      </div>
    {% endif %}

    {% if props.proofpoints_component_props is not empty %}
      <section class="ca-case-study__proofpoints ca-container">
        {% include 'omnichannel:proofpoints' with props.proofpoints_component_props|merge({ card_style: true }) only %}
      </section>
    {% endif %}

    {% if props.quote.quote is not empty %}
      <section class="ca-case-study__quote">
        {% include 'omnichannel:quote' with props.quote only %}
      </section>
    {% endif %}

    {% set body = props.body|render %}
    {% if body|striptags|trim is not empty %}
      <div{{ content_attributes.addClass('node__content ca-case-study__body ca-container ca-container--narrow') }}>
        {{ body }}
      </div>
    {% endif %}

    {# Expertise and Tools #}
    {% set expertise = props.expertise|render %}
    {% set tools = props.tools|render %}
    {% if expertise|striptags|trim is not empty or tools|striptags|trim is not empty %}
      <section class="ca-case-study__expertise-tools ca-container">
        {% if expertise|striptags|trim is not empty %}
          <div class="ca-case-study__expertise">
            <h2 class="ca-case-study__heading">{{ 'Expertise'|t }}</h2>
            {{ expertise }}
          </div>
        {% endif %}
        {% if tools|striptags|trim is not empty %}
          <div class="ca-case-study__tools">
            <h2 class="ca-case-study__heading">{{ 'Tools'|t }}</h2>
            {{ tools }}
          </div>
        {% endif %}
      </section>
    {% endif %}

    {% set outcomes = props.outcomes|render %}
    {% if outcomes|striptags|trim is not empty %}
      <section class="ca-case-study__outcomes">
        <h2 class="ca-case-study__heading">{{ 'Key outcomes'|t }}</h2>
        <div class="ca-case-study__outcomes-grid ca-container">
          {{ outcomes }}
        </div>
      </section>
    {% endif %}

    {% set team_members = props.team_members|render %}
    {% if team_members|striptags|trim is not empty %}
      <section class="ca-case-study__team">
        <div class="ca-case-study__team-inner ca-container">
          <h2 class="ca-case-study__heading">{{ 'Meet the team'|t }}</h2>
          {{ team_members }}
        </div>
      </section>
    {% endif %}
  {% endif %}
{% endblock %}
