{#
/**
 * @file
 * Theme override for a 'form' element.
 *
 * Available variables
 * - attributes: A list of HTML attributes for the wrapper element.
 * - children: The child elements of the form.
 *
 * @see \Drupal\Core\Form\FormPreprocess::preprocessForm()
 */
#}
{%
  set classes = [
    'ca-form',
  ]
%}
{% set form_attributes = attributes|default(create_attribute()) %}
<form{{ form_attributes.addClass(classes) }}>
  {{ children }}
</form>
