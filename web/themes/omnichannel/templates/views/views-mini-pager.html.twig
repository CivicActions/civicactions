{#
/**
 * @file
 * Theme override for a views mini-pager.
 *
 * Available variables:
 * - heading_id: Pagination heading ID.
 * - pagination_heading_level: The heading level to use for the pager.
 * - items: List of pager items.
 *
 * @see template_preprocess_views_mini_pager()
 */
#}
{% if items.previous or items.next or items.current %}
  <nav class="pager ca-pager pager--mini ca-pager--mini" aria-labelledby="{{ heading_id }}">
    <{{ pagination_heading_level }} id="{{ heading_id }}" class="pager__heading visually-hidden">{{ 'Pagination'|t }}</{{ pagination_heading_level }}>
    <ul class="pager__items ca-pager__items js-pager__items">
      {% if items.previous %}
        <li class="pager__item ca-pager__item pager__item--previous ca-pager__item--previous">
          <a href="{{ items.previous.href }}" class="pager__link ca-pager__link" title="{{ 'Go to previous page'|t }}" rel="prev"{{ items.previous.attributes|without('href', 'title', 'rel') }}>
            <span class="visually-hidden">{{ 'Previous page'|t }}</span>
            <span aria-hidden="true">{{ items.previous.text|default('‹ Previous'|t) }}</span>
          </a>
        </li>
      {% else %}
        <li class="pager__item ca-pager__item pager__item--previous ca-pager__item--previous is-disabled" aria-disabled="true">
          <span class="pager__link ca-pager__link is-disabled">
            <span class="visually-hidden">{{ 'Previous page'|t }}</span>
            <span aria-hidden="true">{{ '‹ Previous'|t }}</span>
          </span>
        </li>
      {% endif %}
      {% if items.current %}
        <li class="pager__item ca-pager__item is-active" aria-current="page">
          <span class="pager__link ca-pager__link is-current">
            {% trans %}
              Page {{ items.current }}
            {% endtrans %}
          </span>
        </li>
      {% endif %}
      {% if items.next %}
        <li class="pager__item ca-pager__item pager__item--next ca-pager__item--next">
          <a href="{{ items.next.href }}" class="pager__link ca-pager__link" title="{{ 'Go to next page'|t }}" rel="next"{{ items.next.attributes|without('href', 'title', 'rel') }}>
            <span class="visually-hidden">{{ 'Next page'|t }}</span>
            <span aria-hidden="true">{{ items.next.text|default('Next ›'|t) }}</span>
          </a>
        </li>
      {% else %}
        <li class="pager__item ca-pager__item pager__item--next ca-pager__item--next is-disabled" aria-disabled="true">
          <span class="pager__link ca-pager__link is-disabled">
            <span class="visually-hidden">{{ 'Next page'|t }}</span>
            <span aria-hidden="true">{{ 'Next ›'|t }}</span>
          </span>
        </li>
      {% endif %}
    </ul>
  </nav>
{% endif %}
