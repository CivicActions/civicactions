{#
/**
 * @file
 * Template for the CivicActions Editorial Teaser component.
 *
 * Available props:
 * - variant: Display variant ('card' or 'compact').
 * - teaserlink: Teaser destination.
 * - image: Optional Media Library image.
 * - title: Teaser heading.
 * - description: Optional teaser description.
 */
#}
{% set teaser_variant = variant|default('card') %}
{% set teaser_classes = [
  'editorial-teaser',
  'editorial-teaser--' ~ teaser_variant,
] %}
{% set teaser_attributes = attributes|default(create_attribute()) %}

<div {{ teaser_attributes.addClass(teaser_classes) }}>
  <a href="{{ teaserlink|e('html_attr') }}" class="editorial-teaser__link-{{ teaser_variant == 'compact' ? 'compact' : 'card' }}">
    {% if teaser_variant == 'card' %}
      {% if image %}
        {% set image_srcset = image.src|toSrcSet(image.width) %}
        <img
          class="editorial-teaser__image"
          src="{{ file_url(image.src)|e('html_attr') }}"
          {% if image_srcset %}
            srcset="{{ image_srcset|e('html_attr') }}"
            sizes="auto, 100vw"
          {% endif %}
          alt="{{ image.alt|e('html_attr') }}"
          width="{{ image.width|e('html_attr') }}"
          height="{{ image.height|e('html_attr') }}"
          loading="lazy"
        >
      {% endif %}
      <h3 class="editorial-teaser__title">{{ title }}</h3>
      {% if description %}
        <p class="editorial-teaser__description body">{{ description }}</p>
      {% endif %}
    {% else %}
      <h3 class="editorial-teaser__title">{{ title }}</h3>
      <svg class="editorial-teaser__arrow" width="46" height="30" viewBox="0 0 46 30" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
        <path d="M45.4142 16.4142C46.1953 15.6332 46.1953 14.3668 45.4142 13.5858L32.6863 0.857864C31.9052 0.0768158 30.6389 0.0768158 29.8579 0.857864C29.0768 1.63891 29.0768 2.90524 29.8579 3.68629L41.1716 15L29.8579 26.3137C29.0768 27.0948 29.0768 28.3611 29.8579 29.1421C30.6389 29.9232 31.9052 29.9232 32.6863 29.1421L45.4142 16.4142ZM0 17H44V13H0V17Z" fill="white"/>
      </svg>
    {% endif %}
  </a>
</div>
