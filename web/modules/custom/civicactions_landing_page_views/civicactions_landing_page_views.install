<?php

/**
 * @file
 * Install and update hooks for civicactions_landing_page_views.
 */

/**
 * Creates the CA Team view if it is missing on already-enabled sites.
 */
function civicactions_landing_page_views_update_9001(): void {
  $view_storage = \Drupal::entityTypeManager()->getStorage('view');
  if ($view_storage->load('ca_team')) {
    return;
  }

  $module_path = \Drupal::service('extension.list.module')->getPath('civicactions_landing_page_views');
  $config_path = DRUPAL_ROOT . '/' . $module_path . '/config/install/views.view.ca_team.yml';
  if (!is_file($config_path) || !is_readable($config_path)) {
    throw new \RuntimeException(sprintf('Missing required config file: %s', $config_path));
  }

  $data = \Drupal\Component\Serialization\Yaml::decode((string) file_get_contents($config_path));
  if (!is_array($data) || empty($data['id'])) {
    throw new \RuntimeException('Invalid CA Team view config payload.');
  }

  \Drupal\views\Entity\View::create($data)->save();
}

/**
 * Exposes the Team profile category filter for the listing page.
 */
function civicactions_landing_page_views_update_9002(): void {
  $config = \Drupal::configFactory()->getEditable('views.view.ca_team');
  if (!$config->get('display.default.display_options.filters.profile_category')) {
    return;
  }

  $config
    ->set('display.default.display_options.filters.profile_category.value', [])
    ->set('display.default.display_options.filters.profile_category.exposed', TRUE)
    ->set('display.default.display_options.filters.profile_category.expose.label', 'Team page category')
    ->set('display.default.display_options.filters.profile_category.expose.identifier', 'profile_category')
    ->set('display.default.display_options.filters.profile_category.expose.multiple', TRUE)
    ->save(TRUE);
}

/**
 * Renders the CA News view through the Editorial teaser view mode.
 */
function civicactions_landing_page_views_update_9003(): void {
  $config = \Drupal::configFactory()->getEditable('views.view.ca_news');
  if (!$config->get('display.default')) {
    return;
  }

  $config
    ->set('display.default.display_options.style.options.uses_fields', FALSE)
    ->set('display.default.display_options.row', [
      'type' => 'entity:node',
      'options' => [
        'relationship' => 'none',
        'view_mode' => 'teaser',
      ],
    ])
    ->set('display.default.display_options.fields', [])
    ->save(TRUE);
}
