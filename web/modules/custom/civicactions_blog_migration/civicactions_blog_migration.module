<?php

/**
 * @file
 * Contains hooks and functionality for the CivicActions Blog Migration module.
 */

use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
function civicactions_blog_migration_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    case 'help.page.civicactions_blog_migration':
      return '<p>' . t('The CivicActions Blog Migration module migrates archived Medium publication HTML from blog_archive/ into the Article content type using local metadata and HTML sources.') . '</p>';
  }
}

